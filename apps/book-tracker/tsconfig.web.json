{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "types": [],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/renderer/*"],
      "@shared/*": ["src/shared/*"],
      "@core": ["../../packages/tracker-core/src/index.ts"],
      "@core/*": ["../../packages/tracker-core/src/*"],
      "@ui": ["../../packages/tracker-ui/src/index.ts"],
      "@ui/*": ["../../packages/tracker-ui/src/*"]
    }
  },
  "include": [
    "src/renderer/**/*",
    "src/shared/**/*",
    "../../packages/tracker-core/src/**/*",
    "../../packages/tracker-ui/src/**/*"
  ]
}
