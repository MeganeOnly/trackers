{
  "name": "book-tracker",
  "version": "0.0.1",
  "description": "下位书籍追踪器",
  "author": "you",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "dev:vite": "vite",
    "build:vite": "vite build",
    "dev:tauri": "tauri dev",
    "build:tauri": "tauri build",
    "tauri": "tauri",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-force-graph-2d": "^1.29.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "gray-matter": "^4.0.3",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^4.1.11"
  }
}
