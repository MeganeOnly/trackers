# .git directories nested in apps/* are stale subtree leftovers
# (apps/life-tracker/.git was a 0-item directory after git subtree migration)
# Defensive rule so future 'git subtree add' mistakes don't get tracked
**/.git

# Node / Vite / Tauri renderer
node_modules/
dist/
out/
release/
*.log
.env
.env.local
.DS_Store
.vscode/
.idea/
*.tsbuildinfo

# Vite internal cache (auto-generated, never commit)
**/node_modules/.vite
**/node_modules/.vite-temp

# Tauri auto-generated bindings (regenerated by `tauri dev` / `tauri build`)
src-tauri/gen/
**/src-tauri/gen

# Rust workspace-wide build cache
target/
**/src-tauri/target/

# Windows shell leftovers from desktop / explorer drags
*.lnk

# 杂项文档与编辑器临时
*NOTES.md
LEGACY-LOCATION*.md

# 例外：docs/dev-notes.md 是随仓库走的经验沉淀文件，需纳入版本管理
!docs/dev-notes.md
